# Backend
DATABASE_URL=sqlite:///./glof.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Earth Engine (required for satellite / population on Render)
# Paste the FULL service-account JSON as a single secret on Render:
# EE_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}
EE_PROJECT=glof-portal-502521
# EE_CREDENTIALS_JSON=
# Or path to a local key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Satellite detection cascade thresholds
# 1) GEE Sentinel-2 → 2) Planetary Computer S2 → 3) Sentinel-1 SAR → 4) DB inventory
# GEE_MAX_CLOUD_PCT=30
# PC_MAX_CLOUD_PCT=25
# PC_MIN_CLEAR_SCENES=2
# PC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Frontend (Vite) — set at build time for production
VITE_API_URL=http://127.0.0.1:8000
